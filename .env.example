# =============================================================================
# dnaccarato-copiloto — variáveis de ambiente
# -----------------------------------------------------------------------------
# NUNCA commite o arquivo .env real. Este .env.example serve só de referência.
# Cada variável indica de qual conta/serviço ela vem.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública base da aplicação (usada para montar callbacks e links do widget).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Ambiente de execução: development | production
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Supabase — conta/projeto do próprio projeto Dnaccarato
# -----------------------------------------------------------------------------
# URL do projeto Supabase (pública). Ex: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Chave anon (pública) — usada no client, respeita Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave service_role (SECRETA) — usada SÓ no servidor, ignora RLS.
# Nunca expor no client. Usada por webhooks, cron e MCP.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Asaas (pagamentos/cobranças) — conta Asaas da Adriana
# -----------------------------------------------------------------------------
# API key da conta Asaas da Adriana (produção ou sandbox).
ASAAS_API_KEY=""
# URL base da API Asaas. Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Token compartilhado para validar autenticidade dos webhooks do Asaas.
ASAAS_WEBHOOK_TOKEN=""

# -----------------------------------------------------------------------------
# Autentique (assinatura de documentos) — conta Autentique da Adriana
# -----------------------------------------------------------------------------
# Token da API GraphQL da conta Autentique da Adriana.
AUTENTIQUE_API_TOKEN=""
# Segredo usado para validar a assinatura dos webhooks do Autentique.
AUTENTIQUE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Calendly (agendamentos) — conta Calendly da Adriana
# -----------------------------------------------------------------------------
# Personal Access Token da conta Calendly da Adriana.
CALENDLY_API_TOKEN=""
# Chave de assinatura para validar os webhooks do Calendly (Webhook Signing Key).
CALENDLY_WEBHOOK_SIGNING_KEY=""

# -----------------------------------------------------------------------------
# Asana (gestão de tarefas/projetos) — conta Asana da Adriana
# -----------------------------------------------------------------------------
# Personal Access Token da conta Asana da Adriana.
ASANA_ACCESS_TOKEN=""
# ID do workspace Asana da Adriana usado por padrão.
ASANA_WORKSPACE_ID=""

# -----------------------------------------------------------------------------
# Google Cloud — conta Google Cloud da Adriana
# Cobre Drive, Gmail, Google Agenda (Calendar) e Google Forms.
# App OAuth criado no projeto Google Cloud da Adriana.
# -----------------------------------------------------------------------------
# Client ID do app OAuth (projeto Google Cloud da Adriana).
GOOGLE_CLIENT_ID=""
# Client secret do app OAuth (SECRETO).
GOOGLE_CLIENT_SECRET=""
# URI de redirecionamento OAuth registrada no console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/webhooks/drive/oauth/callback"
# Refresh token de longa duração da conta da Adriana (gerado no fluxo OAuth).
# Dá acesso a Drive, Gmail, Agenda e Forms conforme os escopos concedidos.
GOOGLE_REFRESH_TOKEN=""

# -----------------------------------------------------------------------------
# Anthropic (LLM do copiloto) — conta Anthropic do João / FOVA
# -----------------------------------------------------------------------------
# API key da conta Anthropic do João (FOVA). Usada pelo servidor MCP e briefing.
ANTHROPIC_API_KEY=""
# Modelo padrão usado pelo copiloto.
ANTHROPIC_MODEL="claude-opus-4-8"

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp) — conta Evolution API do João
# -----------------------------------------------------------------------------
# URL base da instância Evolution API do João.
EVOLUTION_API_URL=""
# API key global da Evolution API do João.
EVOLUTION_API_KEY=""
# Nome da instância (número) configurada na Evolution API.
EVOLUTION_INSTANCE=""

# -----------------------------------------------------------------------------
# Cron / jobs internos
# -----------------------------------------------------------------------------
# Segredo compartilhado exigido no header Authorization das rotas /api/cron/*.
# Impede que qualquer um dispare o briefing diário.
CRON_SECRET=""
