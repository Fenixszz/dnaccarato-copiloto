# =============================================================================
# Copiloto Dnaccarato — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite o .env.local.
# =============================================================================

# --- Supabase (banco de dados) -----------------------------------------------
# URL do projeto. Em: Supabase → Project Settings → API → Project URL.
SUPABASE_URL=

# Service role key (uso EXCLUSIVO no servidor — ignora Row Level Security).
# Em: Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (anon), usada pelo browser (dashboard/widget) respeitando RLS.
# Em: Supabase → Project Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Asaas (cobranças e pagamentos) ------------------------------------------
# API key da conta. Em: Asaas → Menu do usuário → Integrações → API.
ASAAS_API_KEY=

# URL base da API. Produção: https://api.asaas.com/v3 (padrão se vazio).
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL=

# Token de autenticação dos webhooks do Asaas (você define ao cadastrar o
# webhook no Asaas; usado pra validar que o evento veio mesmo de lá).
ASAAS_WEBHOOK_TOKEN=

# --- Calendly (agendamentos) -------------------------------------------------
# Personal access token. Em: Calendly → Integrations → API & Webhooks.
CALENDLY_API_TOKEN=

# Signing key dos webhooks (retornada ao criar a webhook subscription via API;
# usada pra verificar a assinatura dos eventos recebidos).
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Google (Drive, Forms, Gmail, Agenda) ------------------------------------
# Credenciais OAuth de um app no Google Cloud Console
# (console.cloud.google.com → APIs & Services → Credentials → OAuth client).
# Habilite as APIs: Drive, Forms, Gmail e Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token da conta Google da clínica, gerado uma vez via fluxo OAuth
# (ex.: OAuth Playground) com os escopos de Drive, Forms, Gmail e Calendar.
GOOGLE_REFRESH_TOKEN=

# Token que o Apps Script / canal de notificação envia nos webhooks de Forms e
# Drive pra provar a origem (você define ao configurar o gatilho).
FORMS_WEBHOOK_TOKEN=
DRIVE_WEBHOOK_TOKEN=

# Id da pasta do Drive onde ficam os documentos de alunas (o trecho após
# /folders/ na URL da pasta). Arquivos nela seguem o padrão
# "Tipo - Nome da Aluna[ - ASSINADO].ext".
DRIVE_PASTA_DOCUMENTOS_ID=

# --- Asana (tarefas da equipe) -----------------------------------------------
# Personal access token. Em: Asana → My Settings → Apps → Developer apps.
ASANA_ACCESS_TOKEN=

# Id do projeto onde as tasks criadas pelo copiloto entram (o número na URL
# do projeto no Asana: app.asana.com/0/<ESTE-NUMERO>/...).
ASANA_PROJETO_ID=

# --- Evolution API (WhatsApp) ------------------------------------------------
# URL base da sua instância da Evolution API (self-hosted ou gerenciada).
EVOLUTION_API_URL=

# API key global da Evolution (definida na configuração do servidor Evolution).
EVOLUTION_API_TOKEN=

# Nome da instância do WhatsApp conectada (criada na própria Evolution API).
EVOLUTION_INSTANCE=

# Token de autenticação dos webhooks que a Evolution envia pra cá (você define
# ao configurar o webhook na Evolution).
EVOLUTION_WEBHOOK_TOKEN=

# Número do WhatsApp da Adriana que recebe o briefing diário e os alertas
# (com DDD; o DDI 55 é adicionado sozinho se faltar). Ex.: 11 91234-5678
ADRIANA_WHATSAPP=

# --- Anthropic (IA do copiloto) ----------------------------------------------
# API key. Em: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# --- Infra -------------------------------------------------------------------
# Segredo do agendador que chama /api/cron/briefing (ex.: Vercel Cron manda
# "Authorization: Bearer <CRON_SECRET>"). Gere um valor aleatório longo.
CRON_SECRET=
