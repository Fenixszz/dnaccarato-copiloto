# =============================================================================
# dnaccarato-copiloto — variáveis de ambiente
# -----------------------------------------------------------------------------
# NUNCA commite o arquivo .env real. Este .env.example serve só de referência.
# Cada variável indica de qual conta/serviço ela vem.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública base da aplicação (usada para montar callbacks e links do widget).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Ambiente de execução: development | production
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Supabase — conta/projeto do próprio projeto Dnaccarato
# -----------------------------------------------------------------------------
# URL do projeto Supabase (pública). Ex: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Chave anon (pública) — usada no client, respeita Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave service_role (SECRETA) — usada SÓ no servidor, ignora RLS.
# Nunca expor no client. Usada por webhooks, cron e MCP.
SUPABASE_SERVICE_ROLE_KEY=""
# String de conexão Postgres do projeto (SECRETA) — usada por `npm run db:migrate`
# para aplicar as migrations. Pegue em Supabase → Project Settings → Database →
# Connection string (URI). NÃO é lida em runtime pela app, só pelos scripts.
SUPABASE_DB_URL=""
# Ref do projeto Supabase (o subdomínio de NEXT_PUBLIC_SUPABASE_URL, ex: "abcd1234").
# Usada por `npm run db:types` (supabase gen types --project-id). Não é segredo.
SUPABASE_PROJECT_ID=""

# -----------------------------------------------------------------------------
# Autenticação do dashboard (Supabase Auth, email/senha)
# -----------------------------------------------------------------------------
# Cadastro é FECHADO: só a Adriana e o João entram. A allowlist é formada por
# EMAIL_ADRIANA (já definido na seção do Google Workspace) + EMAIL_JOAO abaixo.
# Os usuários são provisionados por `npm run seed:usuarios` (Admin API).
#
# E-mail de login do João / FOVA.
EMAIL_JOAO=""
# Senhas iniciais usadas SÓ pelo seed de usuários (não são lidas em runtime).
# Troque por valores fortes; após o seed podem ser removidas do ambiente.
SEED_SENHA_ADRIANA=""
SEED_SENHA_JOAO=""

# -----------------------------------------------------------------------------
# Asaas (pagamentos/cobranças) — conta Asaas da Adriana
# -----------------------------------------------------------------------------
# API key da conta Asaas da Adriana (produção ou sandbox).
ASAAS_API_KEY=""
# URL base da API Asaas. Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Token compartilhado para validar autenticidade dos webhooks do Asaas.
ASAAS_WEBHOOK_TOKEN=""

# -----------------------------------------------------------------------------
# Autentique (assinatura de documentos) — conta Autentique da Adriana
# -----------------------------------------------------------------------------
# Token da API GraphQL da conta Autentique da Adriana.
AUTENTIQUE_API_TOKEN=""
# Segredo usado para validar a assinatura dos webhooks do Autentique.
AUTENTIQUE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Calendly (agendamentos) — conta Calendly da Adriana
# -----------------------------------------------------------------------------
# Personal Access Token da conta Calendly da Adriana.
CALENDLY_API_TOKEN=""
# Chave de assinatura para validar os webhooks do Calendly (Webhook Signing Key).
CALENDLY_WEBHOOK_SIGNING_KEY=""

# -----------------------------------------------------------------------------
# Asana (gestão de tarefas/projetos) — conta Asana da Adriana
# -----------------------------------------------------------------------------
# Personal Access Token da conta Asana da Adriana.
ASANA_ACCESS_TOKEN=""
# ID do workspace Asana da Adriana usado por padrão.
ASANA_WORKSPACE_ID=""
# ID do recurso (projeto de tasks da Adriana) para criar o webhook. O
# X-Hook-Secret é capturado e salvo automaticamente no handshake (não vai aqui).
ASANA_WEBHOOK_RESOURCE_ID=""

# -----------------------------------------------------------------------------
# Google Workspace — conta de serviço no projeto Google Cloud da Adriana
# Cobre Drive, Gmail, Google Agenda (Calendar) e Google Forms via
# domain-wide delegation (impersonation da Adriana). Sem OAuth/refresh/callback.
# -----------------------------------------------------------------------------
# JSON INTEIRO da chave da conta de serviço, codificado em BASE64 (uma linha).
# Gere assim (não commitar o .json nem este valor):
#   base64 -i conta-servico.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=""
# E-mail da Adriana a ser impersonado (subject da delegation).
EMAIL_ADRIANA=""
# ID da pasta RAIZ da Adriana no Drive (uma subpasta por aluna). Pegue o id da
# URL da pasta: https://drive.google.com/drive/folders/<ESTE-ID>
DRIVE_ROOT_FOLDER_ID=""
# Segredo enviado como X-Goog-Channel-Token nas notificações push do Drive e
# conferido pela rota /api/webhooks/drive. Gere um valor aleatório forte.
DRIVE_CHANNEL_TOKEN=""

# -----------------------------------------------------------------------------
# Anthropic (LLM do copiloto) — conta Anthropic do João / FOVA
# -----------------------------------------------------------------------------
# API key da conta Anthropic do João (FOVA). Usada pelo servidor MCP e briefing.
ANTHROPIC_API_KEY=""
# Modelo padrão usado pelo copiloto.
ANTHROPIC_MODEL="claude-opus-4-8"
# (Opcional) Chave de ADMIN da organização Anthropic (sk-ant-admin…). Se
# definida, a tela de créditos mostra ao João o custo REAL de IA dos últimos 30
# dias (Cost Report API) pra conferir contra a estimativa. Sem ela, a seção some.
ANTHROPIC_ADMIN_API_KEY=""
# Token cru de um api_token (só o hash fica no banco) que a Anthropic usa como
# Bearer para chamar o nosso servidor MCP via conector. Escopo = tools liberadas.
MCP_ANTHROPIC_TOKEN=""
# (Opcional) URL pública do servidor MCP. Se vazio, usa NEXT_PUBLIC_APP_URL/api/mcp.
# A Anthropic precisa ALCANÇAR essa URL — em produção, HTTPS público.
MCP_SERVER_URL=""

# -----------------------------------------------------------------------------
# Créditos (medidor de transparência de custo — NUNCA bloqueia nada)
# -----------------------------------------------------------------------------
# Chave Pix do João, exibida na tela pra Adriana copiar e recarregar. Não gera
# QR dinâmico nem chama API de banco — é só o valor da chave.
PIX_CHAVE_JOAO=""
# Tarifas ESTIMADAS pro débito automático (em centavos de real). Ajuste conforme
# a tabela da Anthropic e o câmbio. Defaults ~ Opus 4.8 (US$5/US$25 por 1M tok)
# a ~R$5,40/US$. Se vazias, o código usa esses mesmos defaults.
CREDITO_ANTHROPIC_INPUT_CENTAVOS_POR_MTOK="2700"
CREDITO_ANTHROPIC_OUTPUT_CENTAVOS_POR_MTOK="13500"
# Custo estimado por mensagem enviada no WhatsApp (centavos).
CREDITO_WHATSAPP_CENTAVOS_POR_MSG="5"

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp) — conta Evolution API do João
# -----------------------------------------------------------------------------
# URL base da instância Evolution API do João.
EVOLUTION_API_URL=""
# API key global da Evolution API do João.
EVOLUTION_API_KEY=""
# Nome da instância (número) configurada na Evolution API.
EVOLUTION_INSTANCE=""
# WhatsApp do JOÃO (dígitos ou com máscara) que recebe ALERTAS DE INFRA — hoje:
# erro de billing da Anthropic (saldo/cartão da conta FOVA). NÃO é o da Adriana;
# é problema do João resolver. Se vazio, o alerta fica só em falhas_sistema.
WHATSAPP_JOAO=""

# -----------------------------------------------------------------------------
# Cron / jobs internos
# -----------------------------------------------------------------------------
# Segredo compartilhado exigido no header Authorization das rotas /api/cron/*.
# Impede que qualquer um dispare o briefing diário. A Vercel injeta este valor
# como "Authorization: Bearer <CRON_SECRET>" nas chamadas de cron.
CRON_SECRET=""
# Hora (0-23, fuso America/Sao_Paulo) em que o briefing diário é enviado.
# O cron da Vercel roda de hora em hora; o envio só acontece nesta hora.
BRIEFING_HORA="8"
# WhatsApp da Adriana (só dígitos ou com máscara) que recebe o briefing diário.
BRIEFING_WHATSAPP=""
# Hora limite (0-23, fuso SP): se o briefing não rodou até essa hora, o
# /api/health passa a sinalizar "nao_rodou" (degradado).
BRIEFING_LIMITE_HORA="10"

# -----------------------------------------------------------------------------
# Google Forms (via Apps Script) — Form da Adriana
# -----------------------------------------------------------------------------
# Segredo compartilhado enviado pelo Apps Script no header X-Forms-Secret e
# conferido pela rota /api/webhooks/forms (Apps Script não assina requisição).
# Gere um valor aleatório forte e cole o MESMO valor no Apps Script.
FORMS_WEBHOOK_SECRET=""
