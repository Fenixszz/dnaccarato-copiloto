# =============================================================================
# dnaccarato-copiloto — variáveis de ambiente de STAGING
# -----------------------------------------------------------------------------
# Cópia do .env.example com as diferenças de STAGING anotadas. Dois usos:
#
#   1) LOCAL: rodar scripts contra o banco de staging sem tocar em produção —
#      copie para `.env.staging` (NUNCA commitado) e use os scripts *:staging
#      (ex.: `npm run db:migrate:staging`). Os scripts carregam ESTE arquivo via
#      DOTENV_CONFIG_PATH, então ele precisa ser COMPLETO (não só os overrides).
#
#   2) VERCEL: fonte de referência para os valores dos Environment Variables com
#      escopo "Preview" (Project → Settings → Environment Variables → Preview).
#      A Vercel NÃO lê este arquivo; você cola cada valor lá. Ver STAGING.md.
#
# Regra de ouro: staging NUNCA aponta para dados/contas de produção. Onde houver
# sandbox (Asaas) ou número de teste (WhatsApp), use o de teste — marcado com
# "⚠ STAGING" abaixo.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# ⚠ STAGING: URL estável do ambiente de preview (ver STAGING.md — use um alias
# de branch fixo, ex.: https://staging.SEU-PROJETO.vercel.app). Precisa ser
# estável porque os webhooks das integrações apontam para cá.
NEXT_PUBLIC_APP_URL="https://staging.exemplo.vercel.app"
# Preview builds rodam como produção no Next; mantenha "production".
NODE_ENV="production"

# -----------------------------------------------------------------------------
# Supabase — ⚠ STAGING: PROJETO SUPABASE SEPARADO (não o de produção)
# -----------------------------------------------------------------------------
# URL do projeto Supabase de STAGING.
NEXT_PUBLIC_SUPABASE_URL=""
# Chave anon do projeto de STAGING.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave service_role do projeto de STAGING (SECRETA).
SUPABASE_SERVICE_ROLE_KEY=""
# Connection string Postgres do projeto de STAGING (para db:migrate:staging).
SUPABASE_DB_URL=""
# Ref do projeto de STAGING (subdomínio da URL acima).
SUPABASE_PROJECT_ID=""

# -----------------------------------------------------------------------------
# Autenticação do dashboard
# -----------------------------------------------------------------------------
# Podem ser os MESMOS e-mails (a allowlist é a mesma dupla). Os usuários de
# staging são provisionados no banco de staging por `npm run seed:usuarios:staging`.
EMAIL_JOAO=""
# ⚠ STAGING: use senhas de teste, diferentes das de produção.
SEED_SENHA_ADRIANA=""
SEED_SENHA_JOAO=""

# -----------------------------------------------------------------------------
# Asaas — ⚠ STAGING: use SEMPRE o SANDBOX (nunca a conta de produção da Adriana)
# -----------------------------------------------------------------------------
# API key do SANDBOX Asaas.
ASAAS_API_KEY=""
# Sandbox (fixo em staging).
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
# Token de webhook do sandbox (distinto do de produção).
ASAAS_WEBHOOK_TOKEN=""

# -----------------------------------------------------------------------------
# Autentique — ⚠ STAGING: conta/sandbox de teste, webhook apontando para staging
# -----------------------------------------------------------------------------
AUTENTIQUE_API_TOKEN=""
AUTENTIQUE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Calendly — ⚠ STAGING: token de teste; webhook (Signing Key) próprio de staging
# -----------------------------------------------------------------------------
CALENDLY_API_TOKEN=""
CALENDLY_WEBHOOK_SIGNING_KEY=""

# -----------------------------------------------------------------------------
# Asana — ⚠ STAGING: workspace/projeto de teste; webhook próprio de staging
# -----------------------------------------------------------------------------
ASANA_ACCESS_TOKEN=""
ASANA_WORKSPACE_ID=""
ASANA_WEBHOOK_RESOURCE_ID=""

# -----------------------------------------------------------------------------
# Google Workspace — pode reusar a mesma conta de serviço; ⚠ STAGING: aponte
# para uma pasta RAIZ de teste no Drive (não a pasta real das alunas).
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=""
EMAIL_ADRIANA=""
# ⚠ STAGING: pasta de teste, separada da de produção.
DRIVE_ROOT_FOLDER_ID=""
# Segredo próprio de staging (distinto do de produção).
DRIVE_CHANNEL_TOKEN=""

# -----------------------------------------------------------------------------
# Anthropic — pode reusar a chave da FOVA; ⚠ STAGING: MCP_ANTHROPIC_TOKEN e
# MCP_SERVER_URL são próprios de staging (token distinto, URL do preview).
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
# Opcional; pode ficar vazio em staging (a seção de custo real só aparece com ela).
ANTHROPIC_ADMIN_API_KEY=""
# Token Bearer do MCP de STAGING (gere um api_token distinto no banco de staging).
MCP_ANTHROPIC_TOKEN=""
# ⚠ STAGING: URL pública do MCP de staging (ex.: NEXT_PUBLIC_APP_URL/api/mcp).
MCP_SERVER_URL=""

# -----------------------------------------------------------------------------
# Créditos — pode reusar os mesmos valores de tarifa; Pix pode ficar vazio.
# -----------------------------------------------------------------------------
PIX_CHAVE_JOAO=""
CREDITO_ANTHROPIC_INPUT_CENTAVOS_POR_MTOK="2700"
CREDITO_ANTHROPIC_OUTPUT_CENTAVOS_POR_MTOK="13500"
CREDITO_WHATSAPP_CENTAVOS_POR_MSG="5"

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp) — ⚠ STAGING: INSTÂNCIA E NÚMERO DE TESTE
# -----------------------------------------------------------------------------
# Pode ser a MESMA Evolution API do João, mas com uma INSTÂNCIA separada,
# conectada a um chip/número de TESTE — nunca o número real da Adriana.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
# ⚠ STAGING: nome da instância de teste (ex.: "dnaccarato-staging").
EVOLUTION_INSTANCE=""
# ⚠ STAGING: número de teste que recebe alertas de infra (não o do João de prod,
# a menos que ele queira; mas NUNCA o da Adriana de produção).
WHATSAPP_JOAO=""

# -----------------------------------------------------------------------------
# Cron / jobs internos
# -----------------------------------------------------------------------------
# ⚠ STAGING: segredo próprio (distinto do de produção). Obs.: crons da Vercel
# NÃO rodam em Preview — em staging o briefing é disparado manualmente batendo
# em /api/cron/briefing com este Bearer. Ver STAGING.md.
CRON_SECRET=""
BRIEFING_HORA="8"
# ⚠ STAGING: número de teste que recebe o briefing — NUNCA o da Adriana de prod.
BRIEFING_WHATSAPP=""
BRIEFING_LIMITE_HORA="10"

# -----------------------------------------------------------------------------
# Google Forms (via Apps Script)
# -----------------------------------------------------------------------------
# ⚠ STAGING: segredo próprio; o Apps Script de teste posta para a URL de staging.
FORMS_WEBHOOK_SECRET=""
